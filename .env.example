# Browser-facing Docker port. The reverse-proxied web app opens here.
CLAWVIEW_WEB_PORT=3000
# Browser-facing local bundled mode port. Local mode serves both UI and API here.
CLAWVIEW_LOCAL_PORT=5173
# Internal API port used by the standalone server process and Vite proxy.
CLAWVIEW_PORT=8787

CLAWVIEW_DATA_SOURCE=openclaw
CLAWVIEW_OPENCLAW_HOME=/absolute/path/to/your/.openclaw
CLAWVIEW_CLAWD_DIR=/absolute/path/to/your/clawd
CLAWVIEW_ALLOWED_ORIGIN=http://localhost:3000
CLAWVIEW_ENABLE_OPENCLAW_CLI=true
CLAWVIEW_AGENT_ID=agent_local
CLAWVIEW_AGENT_NAME=我的 OpenClaw
CLAWVIEW_OPENCLAW_BIN=openclaw
CLAWVIEW_OPENCLAW_CONFIG_FILE=openclaw.json
CLAWVIEW_OPENCLAW_LOG_DIR=
CLAWVIEW_GATEWAY_RESTART_COMMAND=
CLAWVIEW_GATEWAY_USAGE_COMMAND=
