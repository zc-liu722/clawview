{
  "name": "clawview",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "corepack pnpm --parallel --filter @clawview/server --filter @clawview/web dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "corepack pnpm -r typecheck",
    "smoke": "./scripts/smoke-check.sh",
    "share": "./scripts/share-clawview.sh tailnet"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.8.2"
  }
}
